<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- Custom, generic spark class. Non-abstract as a fallback. -->
  <!-- You may want to (at the very least) replace the graphic, as by default it uses the vanilla one (color included). -->
  <ThingDef Name="VEF_BaseCustomSpark">
    <defName>VEF_BaseCustomSparkSpark</defName>
    <label>spark</label>
    <category>Projectile</category>
    <thingClass>VEF.Things.CustomFireSpark</thingClass>
    <graphicData>
      <texPath>Things/Projectile/Spark</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <shaderType>Transparent</shaderType>
    </graphicData>
    <tickerType>Normal</tickerType>
    <altitudeLayer>Projectile</altitudeLayer>
    <useHitPoints>false</useHitPoints>
    <neverMultiSelect>true</neverMultiSelect>
    <projectile>
      <alwaysFreeIntercept>true</alwaysFreeIntercept>
      <speed>1.5</speed>
    </projectile>
  </ThingDef>

</Defs>